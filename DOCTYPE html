}

/* =========================================
   HELPERS
========================================= */

const $ = id => document.getElementById(id);

function save(){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(state));
}

function toast(message){

  $("toast").textContent = message;

  $("toast").classList.add("show");

  setTimeout(()=>{
    $("toast").classList.remove("show");
  },2200);

}

function openModal(){
  $("modal").classList.add("open");
}

function closeModal(){
  $("modal").classList.remove("open");
}

$("modal").addEventListener("click",e=>{
  if(e.target.id==="modal"){
    closeModal();
  }
});

function safe(value){
  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function escapeAttr(value){
  return String(value).replace(/'/g,"\\'");
}

/* =========================================
   AUTH
========================================= */

function switchAuth(mode){

  authMode = mode;
  signupStep = 1;

  $("loginTab").classList.toggle("on",mode==="login");
  $("signupTab").classList.toggle("on",mode==="signup");

  renderAuth();

}

function renderAuth(){

  if(authMode==="login"){

    $("authBody").innerHTML = `

      <div class="field">
        <label>Username</label>
        <input id="loginUsername" placeholder="Your username">
      </div>

      <div class="field">
        <label>Family password</label>
        <input id="loginPassword" type="password" placeholder="Family password">
      </div>

      <button class="primary" style="width:100%" onclick="login()">
        Log in
      </button>

      <p style="font-size:12px">
        Family members use their username and the shared family password.
      </p>

    `;

  }else if(signupStep===1){

    $("authBody").innerHTML = `

      <div class="field">
        <label>Your email</label>
        <input id="signupEmail" type="email" placeholder="you@example.com">
      </div>

      <div class="field">
        <label>Username</label>
        <input id="signupUsername" placeholder="Choose a username">
      </div>

      <button class="primary" style="width:100%" onclick="signupNext()">
        Next
      </button>

    `;

  }else if(signupStep===2){

    $("authBody").innerHTML = `

      <div class="field">
        <label>Family name</label>
        <input id="familyNameInput" placeholder="The Smith Family">
      </div>

      <div class="field">
        <label>Family password</label>
        <input id="familyPassword" type="password" placeholder="Create a shared password">
      </div>

      <button class="primary" style="width:100%" onclick="signupNext()">
        Next
      </button>

    `;

  }else{

    $("authBody").innerHTML = `

      <div class="field">
        <label>Your name</label>
        <input id="signupName" placeholder="Your name">
      </div>

      <div class="field">
        <label>Are you an adult?</label>
        <select id="signupRole">
          <option>Adult</option>
          <option>Child</option>
          <option>Grandparent</option>
        </select>
      </div>

      <button class="primary" style="width:100%" onclick="finishSignup()">
        Create family account
      </button>

    `;

  }

}

function signupNext(){

  if(signupStep===1){

    const email = $("signupEmail").value.trim();
    const username = $("signupUsername").value.trim();

    if(!email || !username){
      return toast("Enter your email and username.");
    }

    state.user.email = email;
    state.user.username = username;

    signupStep = 2;

  }else{

    const familyName = $("familyNameInput").value.trim();
    const password = $("familyPassword").value;

    if(!familyName || password.length<4){
      return toast("Add a family name and a 4+ character password.");
    }

    state.family.name = familyName;
    state.family.password = password;

    signupStep = 3;

  }

  renderAuth();

}

function finishSignup(){

  state.user.name =
    $("signupName").value.trim() ||
    state.user.username;

  state.user.role =
    $("signupRole").value;

  state.family.members = [

    {
      name:state.user.name,
      email:state.user.email,
      username:state.user.username,
      role:state.user.role,
      color:state.user.calendarColor
    }

  ];

  save();
  enterApp();

}

function login(){

  const username =
    $("loginUsername").value.trim();

  const password =
    $("loginPassword").value;

  if(!username || !password){
    return toast("Enter username and family password.");
  }

  if(
    state.family.password &&
    password !== state.family.password
  ){
    return toast("Family password is incorrect.");
  }

  state.user.username = username;

  save();
  enterApp();

}

function enterApp(){

  $("auth").classList.add("hidden");
  $("app").classList.remove("hidden");

  applyTheme(state.theme);

  renderAll();

}

function logout(){

  $("app").classList.add("hidden");
  $("auth").classList.remove("hidden");

  switchAuth("login");

}

/* =========================================
   NAVIGATION
========================================= */

function go(view){

  document
    .querySelectorAll(".view")
    .forEach(v=>v.classList.remove("active"));

  $(view).classList.add("active");

  document
    .querySelectorAll(".nav button")
    .forEach(b=>{
      b.classList.toggle(
        "active",
        b.dataset.view===view
      );
    });

  const titles={

    home:"Home",
    planner:"Planner",
    food:"Food",
    calendar:"Calendar",
    family:"Family",
    chat:"Family Chat",
    profile:"My Profile",
    notifications:"Notifications",
    settings:"Settings"

  };

  $("pageTitle").textContent =
    titles[view] || "Track It";

  if(view==="planner") renderPlans();
  if(view==="food") foodTab("inventory");
  if(view==="calendar") renderCalendar();
  if(view==="family") renderFamily();
  if(view==="chat") renderChat();
  if(view==="profile") renderProfile();
  if(view==="notifications") renderNotifications();

}

/* =========================================
   RENDER
========================================= */

function renderAll(){

  const hour =
    new Date().getHours();

  const greeting =
    hour<12
      ? "Good morning"
      : hour<18
        ? "Good afternoon"
        : "Good evening";

  $("hello").textContent =
    greeting +
    (state.user.name
      ? ", "+state.user.name
      : "");

  $("miniName").textContent =
    state.user.name ||
    state.user.username ||
    "Family";

  $("miniAvatar").textContent =
    (state.user.name || "F")
      .charAt(0)
      .toUpperCase();

  $("eventCount").textContent =
    state.events.length;

  $("reminderCount").textContent =
    state.reminders.length;

  $("shoppingCount").textContent =
    state.shopping.length;

  renderToday();
  renderPlans();
  foodTab("inventory");
  renderCalendar();
  renderFamily();
  renderChat();
  renderProfile();
  renderNotifications();

}

/* =========================================
   HOME
========================================= */

function renderToday(){

  const today =
    new Date()
      .toISOString()
      .slice(0,10);

  const events =
    state.events.filter(
      e=>e.date===today
    );

  const reminders =
    state.reminders.filter(
      r=>r.date===today
    );

  let html="";

  events.forEach(event=>{

    html+=`

      <div class="row">

        <i
          class="dot"
          style="background:${event.color}">
        </i>

        <div class="grow">

          <b>
            ${safe(event.time)}
            ·
            ${safe(event.title)}
          </b>

          <small>
            ${safe(event.person)}
            ·
            ${safe(event.type)}
          </small>

        </div>

      </div>

    `;

  });

  reminders.forEach(reminder=>{

    html+=`

      <div class="row">

        <i
          class="dot"
          style="background:#dfa44f">
        </i>

        <div class="grow">

          <b>
            ${safe(reminder.time)}
            ·
            ${safe(reminder.title)}
          </b>

          <small>Reminder</small>

        </div>

      </div>

    `;

  });

  $("todayList").innerHTML =
    html ||
    `<span class="muted">
      Nothing scheduled today.
    </span>`;

  $("kitchen").innerHTML =
    state.food
      .slice(0,4)
      .map(food=>`

        <div class="row">

          <div class="grow">

            <b>${safe(food.name)}</b>

            <small>
              ${safe(food.qty)}
            </small>

          </div>

          <button
            class="soft"
            onclick="markUsed('${escapeAttr(food.name)}')">
            Used
          </button>

        </div>

      `)
      .join("");

  $("homePlans").innerHTML =
    state.plans
      .slice(0,3)
      .map(plan=>`

        <div class="plan">

          <b>
            ${safe(plan.title)}
          </b>

          <small>
            ${safe(plan.when)}
          </small>

        </div>

      `)
      .join("") ||
      `<span class="muted">
        No active plans yet.
      </span>`;

}

/* =========================================
   EVENTS
========================================= */

function openEvent(){

  $("modalBox").innerHTML=`

    <h2>Add event</h2>

    <div class="field">
      <label>What is happening?</label>
      <input
        id="eventTitle"
        placeholder="Meeting, birthday, football, flight..."
      >
    </div>

    <div class="grid3">

      <div class="field">
        <label>Date</label>
