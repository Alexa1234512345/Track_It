function sendMessage(){

  const text =
    $("messageInput")
      .value
      .trim();

  if(!text)return;

  state.messages.push({

    name:
      state.user.name ||
      state.user.username ||
      "You",

    text

  });

  if(
    /toothpaste|buy|shopping/i
      .test(text)
  ){

    const match =
      text.match(
        /(?:buy|shopping)\s+(.+)/i
      );

    state.shopping.push(
      match?.[1] ||
      "New item"
    );

  }

  save();

  $("messageInput")
    .value="";

  renderChat();

  toast("Message sent");

}

