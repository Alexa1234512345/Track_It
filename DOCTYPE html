      </div>

      <div class="field">
        <label>Time</label>
        <input id="eventTime" type="time" value="18:00">
      </div>

      <div class="field">
        <label>Type</label>
        <select id="eventType">
          <option>Event</option>
          <option>Meeting</option>
          <option>Birthday</option>
          <option>Sports</option>
          <option>Flight</option>
          <option>Hotel</option>
          <option>Pickup</option>
          <option>Appointment</option>
          <option>Reminder</option>
        </select>
      </div>

