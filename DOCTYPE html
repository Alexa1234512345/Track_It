<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Track It — Family Assistant</title>

<style>
:root{
  --bg:#f0e5ef;
  --surface:#fffafd;
  --surface2:#f5edf5;
  --text:#29242c;
  --muted:#746b77;
  --accent:#9d55b1;
  --accent2:#ea9bd2;
  --material:linear-gradient(145deg,#fff,#ead9ed);
  --line:rgba(45,30,50,.09);
  --shadow:0 15px 36px rgba(65,42,70,.14);
  --press:0 7px 0 rgba(76,42,84,.14),0 14px 25px rgba(65,42,70,.10);
}

*{box-sizing:border-box}

html,body{
  margin:0;
  padding:0;
  min-height:100%;
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:var(--text);
  background:var(--bg);
}

body{
  overflow-x:hidden;
  transition:background .35s;
}

button,input,textarea,select{font:inherit}

button{
  border:0;
  cursor:pointer;
}

button:active{
  transform:translateY(5px) scale(.98);
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible{
  outline:3px solid rgba(234,155,210,.7);
  outline-offset:2px;
}

.hidden{display:none!important}

/* APP */

.app{
  max-width:1320px;
  margin:auto;
  min-height:100vh;
  padding:16px;
  display:grid;
  grid-template-columns:225px 1fr;
  gap:16px;
}

.panel,
.topbar,
.card,
.modal-box,
.auth-box{
  background:rgba(255,255,255,.90);
  backdrop-filter:blur(18px);
  border:1px solid rgba(255,255,255,.9);
  box-shadow:var(--shadow);
}

/* SIDEBAR */

.sidebar{
  border-radius:29px;
  padding:15px;
  position:sticky;
  top:16px;
  height:calc(100vh - 32px);
}

.logo{
  font-weight:950;
  font-size:29px;
  letter-spacing:-1.5px;
  padding:9px 9px 22px;
}

.logo span{
  color:var(--accent);
}

.nav{
  display:grid;
  gap:8px;
}

.nav button,
.soft,
.primary,
.quick button,
.theme-btn,
.filter-btn{
  background:var(--material);
  color:var(--text);
  box-shadow:var(--press);
  border:1px solid rgba(255,255,255,.75);
  border-radius:16px;
  padding:12px 14px;
  font-weight:900;
  transition:
    transform .13s ease,
    filter .2s ease,
    box-shadow .13s ease;
}

.nav button{
  text-align:left;
}

.nav button.active,
.primary{
  background:linear-gradient(145deg,var(--accent2),var(--accent));
  color:#fff;
}

.nav button:hover,
.soft:hover,
.primary:hover,
.quick button:hover,
.theme-btn:hover,
.filter-btn:hover{
  filter:brightness(1.03);
}

.mini{
  position:absolute;
  bottom:15px;
  left:15px;
  right:15px;
  display:flex;
  gap:10px;
  align-items:center;
  padding:11px;
  border-radius:18px;
  background:rgba(255,255,255,.53);
}

.avatar{
  width:43px;
  height:43px;
  border-radius:50%;
  display:grid;
  place-items:center;
  color:#fff;
  font-weight:950;
  background:linear-gradient(145deg,var(--accent2),var(--accent));
  box-shadow:0 5px 0 rgba(70,35,75,.12);
  overflow:hidden;
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
}

/* MAIN */

.main{
  min-width:0;
}

.topbar{
  border-radius:25px;
  padding:15px 18px;
  margin-bottom:16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.top-title h1{
  font-size:29px;
  margin:0;
  letter-spacing:-1px;
}

.top-title p{
  font-size:12px;
  margin:3px 0 0;
  color:var(--muted);
}

.top-actions{
  display:flex;
  gap:8px;
  align-items:center;
}

/* VIEWS */

.view{
  display:none;
}

.view.active{
  display:block;
}

/* HOME */

.grid2{
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:16px;
}

.grid3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.hero{
  padding:24px;
  border-radius:28px;
  background:var(--material);
  box-shadow:var(--press);
  margin-bottom:16px;
}

.hero h2{
  font-size:32px;
  line-height:1.04;
  margin:0 0 8px;
  letter-spacing:-1.3px;
}

.hero p{
  max-width:780px;
  color:var(--muted);
  margin:0;
}

.quick{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-top:17px;
}

.quick button{
  text-align:left;
}

.card{
  border-radius:26px;
  padding:19px;
  margin-bottom:16px;
}

.head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-bottom:13px;
}

.head h2{
  margin:0;
  font-size:20px;
}

.muted,
small{
  color:var(--muted);
}

.list{
  display:grid;
  gap:8px;
}

.row{
  display:flex;
  align-items:center;
  gap:11px;
  padding:12px;
  border-radius:18px;
  background:rgba(255,255,255,.70);
  border:1px solid var(--line);
}

.grow{
  flex:1;
  min-width:0;
}

.dot{
  width:9px;
  height:41px;
  border-radius:8px;
  background:var(--accent);
  flex:none;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
}

.stat{
  background:rgba(255,255,255,.68);
  padding:14px;
  border-radius:18px;
}

.stat b{
  display:block;
  font-size:24px;
}

/* FORMS */

.search,
.field input,
.field textarea,
.field select{
  width:100%;
  padding:13px 14px;
  border-radius:16px;
  border:1px solid var(--line);
  background:rgba(255,255,255,.86);
  outline:none;
}

.field textarea{
  min-height:90px;
  resize:vertical;
}

.field{
  margin:9px 0;
}

.field label{
  display:block;
  font-size:11px;
  font-weight:900;
  margin-bottom:5px;
}

/* FOOD */

.tabs{
  display:flex;
  gap:8px;
  overflow:auto;
  margin-bottom:13px;
}

.tab-active{
  background:linear-gradient(145deg,var(--accent2),var(--accent))!important;
  color:#fff!important;
}

.foodgrid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.food{
  padding:11px;
  border-radius:22px;
  background:rgba(255,255,255,.72);
  border:1px solid var(--line);
}

.foodimg,
.mealimg{
  height:130px;
  border-radius:18px;
  background:linear-gradient(145deg,var(--surface2),#fff);
  display:grid;
  place-items:center;
  overflow:hidden;
  margin-bottom:10px;
}

.foodimg span,
.mealimg span{
  font-size:34px;
  font-weight:950;
  color:var(--accent);
}

/* CALENDAR */

.calendar-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.month{
  font-size:23px;
  font-weight:950;
}

.calendar{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:6px;
}

.dow{
  text-align:center;
  font-size:11px;
  color:var(--muted);
  font-weight:900;
  padding:5px;
}

.day{
  min-height:82px;
  border-radius:15px;
  background:rgba(255,255,255,.73);
  border:1px solid var(--line);
  padding:8px;
  font-weight:900;
  cursor:pointer;
}

.today{
  outline:3px solid var(--accent2);
}

.chip{
  font-size:9px;
  padding:4px 5px;
  border-radius:7px;
  background:color-mix(in srgb,var(--accent2) 30%,transparent);
  margin-top:5px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

/* PLANNER */

.plan{
  padding:15px;
  border-radius:20px;
  background:rgba(255,255,255,.72);
  border:1px solid var(--line);
}

.plan-step{
  display:flex;
  gap:10px;
  padding:10px 0;
  border-bottom:1px solid var(--line);
}

.badge{
  display:inline-grid;
  place-items:center;
  min-width:28px;
  height:28px;
  border-radius:50%;
  background:#eee4ef;
  font-size:11px;
  font-weight:900;
}

.check{
  width:22px;
  height:22px;
  border:2px solid var(--accent);
  border-radius:7px;
  background:transparent;
  position:relative;
}

.check.done{
  background:var(--accent);
}

.check.done:after{
  content:"";
  position:absolute;
  width:8px;
  height:4px;
  border-left:2px solid white;
  border-bottom:2px solid white;
  transform:rotate(-45deg);
  left:5px;
  top:5px;
}

/* CHAT */

.chat{
  height:450px;
  display:flex;
  flex-direction:column;
}

.messages{
  flex:1;
  overflow:auto;
  display:grid;
  gap:8px;
  padding:4px;
}

.bubble{
  max-width:80%;
  padding:10px 13px;
  border-radius:18px;
  background:rgba(255,255,255,.72);
  border:1px solid var(--line);
}

.me{
  margin-left:auto;
  background:linear-gradient(145deg,var(--accent2),var(--accent));
  color:#fff;
}

.chatbar{
  display:flex;
  gap:8px;
  margin-top:10px;
}

.chatbar input{
  flex:1;
}

/* FAMILY */

.member{
  display:flex;
  align-items:center;
  gap:11px;
  padding:13px;
  border-radius:18px;
  background:rgba(255,255,255,.72);
  border:1px solid var(--line);
}

.member .avatar{
  width:46px;
  height:46px;
}

.badge-small{
  padding:5px 9px;
  border-radius:999px;
  background:#eee4ef;
  font-size:10px;
  font-weight:900;
}

/* SETTINGS */

.setting{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:15px 0;
  border-bottom:1px solid var(--line);
}

.setting:last-child{
  border:0;
}

/* THEMES */

.themegrid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.theme-btn{
  min-height:112px;
  text-align:left;
}

.pink{
  background:radial-gradient(circle at 28% 18%,#ffe7f4,#d57fc1 48%,#784d78);
  color:#fff;
}

.gold{
  background:linear-gradient(130deg,#65430b,#e5b83f,#fff1a1,#8a5d0e,#edc64e);
  color:#fff;
}

.jelly{
  background:linear-gradient(145deg,#fff,#8fc1ff);
}

.clay{
  background:linear-gradient(145deg,#f6dac8,#c98266);
}

.plush{
  background:radial-gradient(circle at 30% 20%,#ffe3f5,#bd70b2,#71486f);
  color:#fff;
}

.holo{
  background:linear-gradient(120deg,#a7efff,#efb2ff,#fff0a6,#b8ffd7);
}

.silver{
  background:linear-gradient(135deg,#68717f,#f7f9fc,#929ba9,#fff);
}

.dark{
  background:linear-gradient(145deg,#3b3843,#111);
  color:#fff;
}

.material-preview{
  margin-top:12px;
  padding:15px;
  border-radius:20px;
  background:var(--material);
  box-shadow:var(--press);
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(20,10,20,.42);
  backdrop-filter:blur(9px);
  display:none;
  align-items:flex-end;
  justify-content:center;
  padding:15px;
  z-index:20;
}

.modal.open{
  display:flex;
}

.modal-box{
  width:min(740px,100%);
  max-height:91vh;
  overflow:auto;
  border-radius:31px;
  padding:22px;
}

.actions{
  display:flex;
  justify-content:flex-end;
  gap:8px;
  margin-top:14px;
}

/* AUTH */

.auth{
  min-height:100vh;
  display:grid;
  place-items:center;
  padding:16px;
}

.auth-box{
  width:min(550px,100%);
  padding:30px;
  border-radius:31px;
}

.auth-box h1{
  text-align:center;
  font-size:40px;
  margin:0;
}

.auth-box h1 span{
  color:var(--accent);
}

.auth-box p{
  text-align:center;
  color:var(--muted);
}

.auth-tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  margin:17px 0;
}

.auth-tabs button{
  padding:12px;
  border-radius:14px;
  background:var(--surface2);
  font-weight:900;
}

.auth-tabs button.on{
  background:var(--accent);
  color:#fff;
}

.invite-note{
  padding:11px 12px;
  border-radius:15px;
  background:#f9eef8;
  color:var(--muted);
  font-size:12px;
}

.toast{
  position:fixed;
  left:50%;
  bottom:20px;
  transform:translate(-50%,20px);
  opacity:0;
  background:#29242c;
  color:#fff;
  padding:11px 16px;
  border-radius:15px;
  transition:.2s;
  z-index:50;
}

.toast.show{
  opacity:1;
  transform:translate(-50%,0);
}

.results-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

.result{
  padding:14px;
  border-radius:18px;
  background:rgba(255,255,255,.70);
  border:1px solid var(--line);
}

.result h4{
  margin:0 0 4px;
}

/* RESPONSIVE */

@media(max-width:900px){
  .app{
    display:block;
    padding:9px;
  }

  .sidebar{
    position:static;
    height:auto;
    margin-bottom:10px;
  }

  .nav{
    display:flex;
    overflow:auto;
  }

  .nav button{
    white-space:nowrap;
  }

  .mini{
    display:none;
  }

  .grid2{
    grid-template-columns:1fr;
  }

  .quick{
    grid-template-columns:1fr 1fr;
  }

  .foodgrid{
    grid-template-columns:1fr 1fr;
  }

  .themegrid{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:540px){
  .topbar{
    align-items:flex-start;
  }

  .top-actions .primary{
    display:none;
  }

  .hero h2{
    font-size:26px;
  }

  .day{
    min-height:65px;
    font-size:12px;
  }

  .chip{
    display:none;
  }

  .results-grid{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<!-- AUTH -->
<div id="auth" class="auth hidden">
  <div class="auth-box">
    <h1>Track<span> It</span></h1>
    <p>Your family's plans, food, calendar and reminders in one place.</p>

    <div class="auth-tabs">
      <button id="loginTab" class="on" onclick="switchAuth('login')">Log in</button>
      <button id="signupTab" onclick="switchAuth('signup')">Create family</button>
    </div>

    <div id="authBody"></div>
  </div>
</div>

<!-- APP -->
<div id="app" class="app hidden">

  <aside class="sidebar panel">
    <div class="logo">Track<span> It</span></div>

    <div class="nav">
      <button data-view="home" class="active" onclick="go('home')">Home</button>
      <button data-view="planner" onclick="go('planner')">Planner</button>
      <button data-view="food" onclick="go('food')">Food</button>
      <button data-view="calendar" onclick="go('calendar')">Calendar</button>
      <button data-view="family" onclick="go('family')">Family</button>
      <button data-view="chat" onclick="go('chat')">Chat</button>
    </div>

    <div class="mini">
      <div class="avatar" id="miniAvatar">F</div>
      <div>
        <b id="miniName">Family</b>
        <small>Family account</small>
      </div>
    </div>
  </aside>

  <main class="main">

    <header class="topbar">
      <div class="top-title">
        <h1 id="pageTitle">Home</h1>
        <p>Everything your family needs, in one place.</p>
      </div>

      <div class="top-actions">
        <button class="soft" onclick="go('settings')">Settings</button>
        <button class="primary" onclick="openEvent()">+ Event</button>
      </div>
    </header>

    <!-- HOME -->
    <section id="home" class="view active">

      <div class="hero">
        <h2 id="hello">Good morning</h2>
        <p>
          One fast place for planning, calendar, food, shopping,
          reminders, family chat and travel.
        </p>

        <div class="quick">
          <button onclick="openPlanner()">Plan something</button>
          <button onclick="openQuickItem()">+ Item</button>
          <button onclick="go('chat')">Family chat</button>
          <button onclick="openAI()">Ask Track It AI</button>
        </div>
      </div>

      <div class="grid2">

        <div>

          <div class="card">
            <div class="head">
              <h2>Today</h2>
              <button class="soft" onclick="go('calendar')">Calendar</button>
            </div>
            <div id="todayList" class="list"></div>
          </div>

          <div class="card">
            <div class="head">
              <h2>Active plans</h2>
              <button class="soft" onclick="openPlanner()">+ Plan</button>
            </div>
            <div id="homePlans" class="list"></div>
          </div>

        </div>

        <div>

          <div class="card">
            <div class="head">
              <h2>At a glance</h2>
              <button class="soft" onclick="go('family')">Family</button>
            </div>

            <div class="stats">
              <div class="stat">
                <b id="eventCount">0</b>
                <small>events</small>
              </div>

              <div class="stat">
                <b id="reminderCount">0</b>
                <small>reminders</small>
              </div>

              <div class="stat">
                <b id="shoppingCount">0</b>
                <small>shopping</small>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="head">
              <h2>Kitchen</h2>
              <button class="soft" onclick="go('food')">Open</button>
            </div>
            <div id="kitchen" class="list"></div>
          </div>

          <div class="card">
            <b>While you're away</b>
            <p class="muted">
              Track It first checks what you already planned,
              then looks for real nearby events that actually fit your free time.
            </p>
            <button class="primary" onclick="openTravel()">
              Explore around my trip
            </button>
          </div>

        </div>

      </div>
    </section>

    <!-- PLANNER -->
    <section id="planner" class="view">
      <div class="card">

        <div class="head">
          <div>
            <h2>Planner</h2>
            <div class="muted">
              Tell Track It what you want in normal human language.
            </div>
          </div>

          <button class="primary" onclick="openPlanner()">+ New plan</button>
        </div>

        <div id="plans" class="list"></div>

      </div>
    </section>

    <!-- FOOD -->
    <section id="food" class="view">
      <div class="card">

        <div class="head">
          <div>
            <h2>Food</h2>
            <div class="muted">My Food, Shopping and Meals.</div>
          </div>

          <button class="primary" onclick="openQuickItem()">+ Item</button>
        </div>

        <div class="tabs">
          <button id="tabInventory" class="soft tab-active" onclick="foodTab('inventory')">
            My Food
          </button>

          <button id="tabShopping" class="soft" onclick="foodTab('shopping')">
            Shopping
          </button>

          <button id="tabMeals" class="soft" onclick="foodTab('meals')">
            Meals
          </button>
        </div>

        <div id="foodBody"></div>

      </div>
    </section>

    <!-- CALENDAR -->
    <section id="calendar" class="view">
      <div class="card">

        <div class="calendar-head">
          <button class="soft" onclick="changeMonth(-1)">Previous</button>
          <div class="month" id="monthTitle"></div>
          <button class="soft" onclick="changeMonth(1)">Next</button>
        </div>

        <div id="calendarGrid" class="calendar"></div>

      </div>
    </section>

    <!-- FAMILY -->
    <section id="family" class="view">
      <div class="grid2">

        <div class="card">
          <div class="head">
            <div>
              <h2>Family account</h2>
              <div class="muted" id="familyTitle"></div>
            </div>

            <button class="primary" onclick="openFamilyMember()">
              + Family member
            </button>
          </div>

          <div class="invite-note">
            Each person has a name, email, username, Adult/Child status
            and calendar colour. The production app sends the invitation email.
          </div>

          <div id="familyMembers" class="list" style="margin-top:10px"></div>
        </div>

        <div class="card">

          <div class="head">
            <h2>Upcoming together</h2>
          </div>

          <div id="familyUpcoming" class="list"></div>

        </div>

      </div>
    </section>

    <!-- CHAT -->
    <section id="chat" class="view">

      <div class="card chat">

        <div class="head">
          <div>
            <h2>Family Chat</h2>
            <div class="muted">
              Messages can become useful actions.
            </div>
          </div>
        </div>

        <div id="messages" class="messages"></div>

        <div class="chatbar">
          <input
            id="messageInput"
            placeholder="Message your family..."
            onkeydown="if(event.key==='Enter')sendMessage()"
          >

          <button class="primary" onclick="sendMessage()">
            Send
          </button>
        </div>

      </div>
    </section>

    <!-- PROFILE -->
