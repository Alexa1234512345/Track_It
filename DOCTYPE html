function renderCalendar(){

  const first =
    new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth(),
      1
    );

  const last =
    new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth()+1,
      0
    );

  $("monthTitle")
    .textContent =
      first.toLocaleDateString(
        undefined,
        {
          month:"long",
          year:"numeric"
        }
      );

  let html =
    [
      "Sun",
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri",
      "Sat"
    ]
      .map(
        day=>
          `<div class="dow">${day}</div>`
      )
      .join("");

  for(
    let i=0;
    i<first.getDay();
    i++
  ){
    html+="<div></div>";
  }

  for(
    let day=1;
    day<=last.getDate();
    day++
  ){

    const date =
      `${calendarDate.getFullYear()}-${String(calendarDate.getMonth()+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;

    const events =
      state.events.filter(
        event=>event.date===date
      );

    html+=`

      <div
        class="day ${
          date===new Date()
            .toISOString()
            .slice(0,10)
            ? "today"
            : ""
        }"
        onclick="openCalendarDate('${date}')">

        ${day}

        ${
          events
            .map(
              event=>
                `<div class="chip">
                  ${safe(event.time)}
                  ${safe(event.title)}
                </div>`
            )
            .join("")
        }

      </div>

    `;

  }

  $("calendarGrid").innerHTML=html;

}

function changeMonth(amount){

  calendarDate.setMonth(
    calendarDate.getMonth()+amount
