  state.user.email ||
  state.family.password
){

  $("auth")
    .classList
    .add("hidden");

  $("app")
    .classList
    .remove("hidden");

  applyTheme(state.theme);

  renderAll();

}else{

  $("auth")
    .classList
    .remove("hidden");

  switchAuth("login");

}

</script>

