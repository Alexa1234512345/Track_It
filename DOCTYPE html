function applyCustomTheme(){

  const request =
    (
      $("themeRequest").value ||
      ""
    ).toLowerCase();

  let theme;

  if(request.includes("gold")){

    theme="gold";

  }else if(
    request.includes("jelly") ||
    request.includes("slime")
  ){

    theme="jelly";

  }else if(
    request.includes("clay")
  ){

    theme="clay";

  }else if(
    request.includes("silver")
  ){

    theme="silver";

  }else if(
    request.includes("holographic") ||
    request.includes("holo")
  ){

    theme="holo";

  }else if(
    request.includes("dark")
  ){

    theme="dark";

  }else if(
    request.includes("plush") ||
    request.includes("fluffy")
  ){

    theme="pink";

  }else{

    theme="pink";

  }

  applyTheme(theme);

}

