const STORAGE_KEY = "track-it-full-app";

let state = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");

let authMode = "login";
let signupStep = 1;
let calendarDate = new Date();
let soundEnabled = true;

if(!state){

