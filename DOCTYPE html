/* =========================================
   FOOD
========================================= */

function markUsed(name){

  const index=
    state.food.findIndex(
      food=>food.name===name
    );

  if(index<0){
    return;
  }

  state.shopping.push(name);

  state.food.splice(
    index,
    1
  );

  save();
  renderAll();

  toast(
    name+
    " moved to Shopping"
  );

}

function filterFood(query){

  document
    .querySelectorAll("#foodGrid .food")
    .forEach(card=>{

      card.style.display =
        card.dataset.name
          .includes(
            query
              .toLowerCase()
          )
          ? ""
          : "none";

    });

}

function completeShopping(index,button){

  button.classList.toggle(
    "done"
  );

  if(button.classList.contains("done")){

    setTimeout(()=>{

      state.shopping.splice(
        index,
        1
      );

      save();

      foodTab("shopping");
      renderAll();

    },300);

  }

}

function removeShopping(index){

  state.shopping.splice(
    index,
    1
  );

  save();

  foodTab("shopping");
  renderAll();

}

function toggleFavourite(name,button){

  if(
    state.favourites
