function saveEvent(){

  const title =
    $("eventTitle")
      .value
      .trim();

  if(!title){
    return toast(
      "Give the event a name."
    );
  }

  const person =
    $("eventPerson")
      .value
      .trim() ||
    "Family";

  const member =
    state.family.members
      .find(
        m=>m.name===person
      );

  const color =
    person==="Family"
      ? "#9d55b1"
      : member?.color || "#9d55b1";

  state.events.push({

    title,

    date:
      $("eventDate").value,

    time:
      $("eventTime").value,

    person,

    color,

    type:
      $("eventType").value

  });

  save();

  closeModal();
  renderAll();

  toast("Event added");

}

/* =========================================
   SMART PLANNER
========================================= */

function openPlanner(){

  $("modalBox").innerHTML=`

    <h2>Plan something</h2>

    <p class="muted">

      Write it like you would say it to a person.
      The production AI should understand the goal,
      date, people, constraints and existing schedule,
      then ask only the important missing questions.

    </p>

    <div class="field">

      <label>What do you want to plan?</label>

      <textarea
        id="plannerRequest"
        placeholder="Plan a sleepover for 6 people next Saturday..."
      ></textarea>

    </div>

    <div class="field">

      <label>Anything else you already know?</label>

      <input
        id="plannerExtra"
        placeholder="Location, guests, food, budget, activities..."
      >

    </div>

    <div class="actions">

      <button
        class="soft"
        onclick="closeModal()">
        Cancel
      </button>

      <button
        class="primary"
        onclick="buildSmartPlan()">
        Build plan
      </button>

    </div>

  `;

  openModal();

}

function buildSmartPlan(){

  const text =
    $("plannerRequest")
      .value
      .trim();

  if(!text){
    return toast(
      "Tell Track It what you want to plan."
    );
  }

  const lower =
    text.toLowerCase();

  let steps=[];

  if(lower.includes("sleepover")){

    steps=[
      "Confirm guests and host",
      "Choose arrival and pickup times",
      "Check existing calendar for conflicts",
      "Plan dinner, snacks and drinks",
      "Check My Food",
      "Add missing items to Shopping",
      "Choose activities or movie",
      "Set reminders",
      "Final check"
    ];

  }else if(lower.includes("birthday")){

    steps=[
      "Guest list",
      "Find a date/time that works",
      "Check family calendar",
      "Choose food and cake",
      "Plan activities",
      "Build shopping list",
      "Send invitations",
      "Set reminders",
      "Final check"
    ];

  }else if(
    lower.includes("trip") ||
    lower.includes("holiday") ||
    lower.includes("vacation")
  ){

    steps=[
      "Dates and destination",
      "Check existing flights and hotels",
      "Calculate travel time",
      "Plan free-time windows",
      "Find real nearby events",
      "Plan food and packing",
      "Set reminders",
      "Final itinerary"
    ];

  }else{

    steps=[
      "Understand the goal",
      "Check existing plans",
      "Choose people and timing",
      "Identify anything needed",
      "Add Food or Shopping items",
      "Create calendar items",
      "Set reminders",
      "Final check"
    ];

  }

  state.plans.unshift({

    title:text,

    when:"Active plan",

    extra:
      $("plannerExtra")
        .value
        .trim(),

    steps

  });

  save();
  closeModal();
  renderAll();
  go("planner");

  toast("Plan created");

}

function renderPlans(){

  $("plans").innerHTML =
    state.plans
      .map(
        (plan,index)=>`

          <div class="plan">

            <div class="head">

              <div>

                <b>
                  ${safe(plan.title)}
                </b>

                <small>
                  ${safe(plan.when)}
                </small>

              </div>

              <button
                class="soft"
                onclick="openPlanDetails(${index})">
                Open
              </button>

            </div>

            ${
              plan.steps
                .map(
                  (step,index)=>`

                    <div class="plan-step">

                      <button
                        class="check"
                        onclick="this.classList.toggle('done')">
                      </button>

                      <span class="badge">
                        ${index+1}
                      </span>

                      <div>

                        <b>
                          ${safe(step)}
                        </b>

                        <small
                          style="display:block">
                          Connect to calendar,
                          reminders,
                          food or shopping.
                        </small>

                      </div>

                    </div>

                  `
                )
                .join("")
            }

          </div>

        `
      )
      .join("") ||

    `<span class="muted">
      No plans yet.
      Try “Plan a sleepover next Saturday.”
    </span>`;

}

function openPlanDetails(index){

  const plan=
    state.plans[index];

  $("modalBox").innerHTML=`

    <h2>
      ${safe(plan.title)}
    </h2>

    <p class="muted">
      ${safe(plan.when)}
    </p>

    ${
      plan.steps
        .map(
          (step,index)=>`

            <div class="row">

              <button
                class="check"
                onclick="this.classList.toggle('done')">
              </button>

              <div class="grow">

                <b>
                  ${index+1}.
                  ${safe(step)}
                </b>

              </div>

            </div>

          `
        )
        .join("")
    }

    <div class="actions">

      <button
        class="primary"
        onclick="closeModal()">
        Done
      </button>

    </div>

  `;

  openModal();

}

